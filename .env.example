# ============================================================
# YIMU CRM 环境变量模板
# 用法：
#   1) 复制本文件为 .env.local（本地开发用，已被 git 忽略，不会泄露）
#   2) 部署到 Vercel 时，在 Vercel 控制台 → Environment Variables 填入同名变量
# ============================================================

# ---- Supabase（云端数据库）----
# 部署到 Vercel / 上线时必须填写；本地开发不填则自动回退到本地文件。
# 获取位置：Supabase 控制台 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://你的项目ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=你的service_role密钥

# ---- 应用密钥 ----
# JWT 签名密钥：部署时请改成一段随机长字符串（可用 https://randomkeygen.com 生成）
JWT_SECRET=crm-local-dev-secret-change-in-production
COOKIE_NAME=crm_token
